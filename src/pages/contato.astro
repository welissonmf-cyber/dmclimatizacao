---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import Icone from '../components/Icone.astro';
import Preencher from '../components/Preencher.astro';
import { empresa, linkTel, linkWhatsApp } from '../data/empresa';

const mensagem = 'Olá! Vim pela página de contato do site e gostaria de um orçamento.';

const tiposServico = [
  'Instalação',
  'Manutenção preventiva',
  'Conserto / manutenção corretiva',
  'Limpeza e higienização',
  'PMOC para empresa',
  'Projeto / VRF',
  'Outro',
];
---

<Base
  titulo="Contato e Orçamento de Ar Condicionado em BH | DM Climatização"
  descricao="Peça orçamento de instalação, manutenção, higienização ou PMOC de ar condicionado em Belo Horizonte e região pelo WhatsApp, telefone ou formulário."
  mensagemWhatsApp={mensagem}
>
  <CabecalhoPagina
    rotulo="Contato"
    titulo="Fale com a DM Climatização"
    apoio="O jeito mais rápido é o WhatsApp: mande fotos do aparelho ou do local e respondemos com orientação e orçamento."
  />

  <section class="secao">
    <div class="container contato">
      <div class="contato__canais">
        <a class="btn btn--acao contato__whatsapp" href={linkWhatsApp(mensagem)} target="_blank" rel="noopener">
          <Icone nome="whatsapp" />
          WhatsApp {empresa.whatsapp.exibicao}
        </a>

        <ul class="contato__lista" role="list">
          {
            empresa.telefones.map((t) => (
              <li>
                <Icone nome="telefone" />
                <div>
                  <span class="contato__rotulo">Telefone</span>
                  <a href={linkTel(t.numero)}>{t.exibicao}</a>
                </div>
              </li>
            ))
          }
          <li>
            <Icone nome="email" />
            <div>
              <span class="contato__rotulo">E-mail</span>
              <a href={`mailto:${empresa.email}`}>{empresa.email}</a>
            </div>
          </li>
          <li>
            <Icone nome="local" />
            <div>
              <span class="contato__rotulo">Área de atendimento</span>
              {empresa.cidadesAtendidas ? empresa.cidadesAtendidas.join(', ') : empresa.areaResumo}
            </div>
          </li>
          <li>
            <Icone nome="relogio" />
            <div>
              <span class="contato__rotulo">Horário</span>
              {empresa.horario ?? <Preencher>horário de atendimento</Preencher>}
            </div>
          </li>
        </ul>
      </div>

      <div class="cartao formulario">
        <h2>Ou envie uma mensagem</h2>
        <p class="formulario__apoio">Respondemos pelo telefone ou WhatsApp informado.</p>
        <!-- Envio (Formspree / Web3Forms / PHP), validação e mensagens de sucesso/erro: Fase 3 -->
        <form class="form" method="post" data-formulario-contato>
          <div class="campo">
            <label for="nome">Nome</label>
            <input id="nome" name="nome" type="text" autocomplete="name" required />
          </div>
          <div class="campo">
            <label for="telefone">Telefone ou WhatsApp</label>
            <input id="telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(31) 9XXXX-XXXX" required />
          </div>
          <div class="campo">
            <label for="cidade">Cidade / bairro</label>
            <input id="cidade" name="cidade" type="text" autocomplete="address-level2" />
          </div>
          <div class="campo">
            <label for="servico">Tipo de serviço</label>
            <select id="servico" name="servico" required>
              <option value="">Selecione</option>
              {tiposServico.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="campo">
            <label for="mensagem">Mensagem</label>
            <textarea id="mensagem" name="mensagem" rows="4" placeholder="Conte o que precisa: modelo do aparelho, quantidade, problema..."></textarea>
          </div>
          <p class="form__lgpd">
            Usamos seus dados apenas para responder a este contato. Veja a
            <a href="/privacidade.html">política de privacidade</a>.
          </p>
          <button class="btn btn--acao" type="submit">Enviar mensagem</button>
          <p><Preencher>ligar o envio do formulário (Fase 3)</Preencher></p>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .contato {
    display: grid;
    gap: var(--esp-7);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .contato {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .contato__whatsapp {
    width: 100%;
  }

  .contato__lista {
    margin: var(--esp-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .contato__lista li {
    display: flex;
    gap: var(--esp-4);
    padding-block: var(--esp-4);
    border-bottom: 1px solid var(--gelo-borda);
  }

  .contato__lista :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--azul-ar);
  }

  .contato__lista a {
    font-size: var(--fs-lg);
    font-weight: 500;
  }

  .contato__rotulo {
    display: block;
    color: var(--texto-suave);
    font-size: var(--fs-sm);
  }

  .formulario {
    padding: var(--esp-6);
    background: var(--gelo);
    border: 0;
  }

  .formulario h2 {
    font-size: var(--fs-h3);
    margin-bottom: var(--esp-1);
  }

  .formulario__apoio {
    color: var(--texto-suave);
  }

  .form {
    display: grid;
    gap: var(--esp-4);
  }

  .campo {
    display: grid;
    gap: var(--esp-1);
  }

  .campo label {
    color: var(--azul-tecnico);
    font-weight: 500;
  }

  .campo input,
  .campo select,
  .campo textarea {
    width: 100%;
    min-height: 3rem;
    padding: var(--esp-3);
    border: 1px solid #6f8797;
    border-radius: var(--raio);
    background: var(--branco);
    color: var(--texto);
    font: inherit;
  }

  .campo textarea {
    resize: vertical;
  }

  .campo input:focus-visible,
  .campo select:focus-visible,
  .campo textarea:focus-visible {
    outline: 3px solid var(--azul-logo);
    outline-offset: 0;
    border-color: var(--azul-ar);
  }

  .form__lgpd {
    margin: 0;
    color: var(--texto-suave);
    font-size: var(--fs-sm);
  }

  .form .btn {
    justify-self: start;
  }
</style>

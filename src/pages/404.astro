---
import Base from '../layouts/Base.astro';
import CabecalhoPagina from '../components/CabecalhoPagina.astro';
import { servicos } from '../data/servicos';
---

<Base titulo="Página não encontrada | DM Climatização" descricao="A página procurada não existe ou mudou de endereço." semIndexar>
  <CabecalhoPagina
    titulo="Página não encontrada"
    apoio="O endereço pode ter mudado. Veja se algum destes links ajuda:"
  />
  <section class="secao">
    <div class="container">
      <ul class="lista-check">
        <li><a href="/">Página inicial</a></li>
        {servicos.map((s) => <li><a href={s.href}>{s.titulo}</a></li>)}
        <li><a href="/contato">Contato</a></li>
      </ul>
    </div>
  </section>
</Base>

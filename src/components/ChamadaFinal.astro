---
/** Faixa de fechamento com os dois caminhos de contato. Usada no fim das páginas. */
import Icone from './Icone.astro';
import { empresa, linkTel, linkWhatsApp } from '../data/empresa';

interface Props {
  titulo?: string;
  texto?: string;
  mensagemWhatsApp: string;
  rotuloBotao?: string;
}

const {
  titulo = 'Vamos resolver o seu ar condicionado?',
  texto = 'Mande uma mensagem com o modelo do aparelho ou uma foto do local. Respondemos com orientação e orçamento.',
  mensagemWhatsApp,
  rotuloBotao = 'Pedir orçamento no WhatsApp',
} = Astro.props;
---

<section class="chamada">
  <div class="container chamada__conteudo">
    <div>
      <h2>{titulo}</h2>
      <p>{texto}</p>
    </div>
    <div class="chamada__acoes">
      <a class="btn btn--acao" href={linkWhatsApp(mensagemWhatsApp)} target="_blank" rel="noopener">
        <Icone nome="whatsapp" />
        {rotuloBotao}
      </a>
      <a class="btn btn--claro" href={linkTel(empresa.telefones[0].numero)}>
        <Icone nome="telefone" />
        {empresa.telefones[0].exibicao}
      </a>
    </div>
  </div>
</section>

<style>
  .chamada {
    padding-block: var(--esp-7);
    background: var(--azul-tecnico-escuro);
    color: rgb(255 255 255 / 0.85);
  }

  .chamada h2 {
    color: var(--branco);
    margin-bottom: var(--esp-2);
  }

  .chamada p {
    max-width: 38rem;
    margin: 0;
  }

  .chamada__conteudo {
    display: grid;
    gap: var(--esp-5);
    align-items: center;
  }

  .chamada__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-3);
  }

  @media (min-width: 64rem) {
    .chamada__conteudo {
      grid-template-columns: 1fr auto;
      gap: var(--esp-7);
    }
  }

  @media (max-width: 30rem) {
    .chamada__acoes .btn {
      width: 100%;
    }
  }
</style>

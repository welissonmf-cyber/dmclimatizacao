---
import Texto from './Texto.astro';
import type { Pergunta } from '../data/faq';

interface Props {
  perguntas: Pergunta[];
}

const { perguntas } = Astro.props;
---

<div class="faq">
  {
    perguntas.map((p) => (
      <details class="faq__item">
        <summary class="faq__pergunta">{p.pergunta}</summary>
        <p class="faq__resposta">
          <Texto texto={p.resposta} />
        </p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: var(--esp-3);
    max-width: 48rem;
  }

  .faq__item {
    border: 1px solid var(--gelo-borda);
    border-radius: var(--raio);
    background: var(--branco);
  }

  .faq__pergunta {
    position: relative;
    padding: var(--esp-4) 3rem var(--esp-4) var(--esp-5);
    color: var(--azul-tecnico);
    font-family: var(--fonte-titulo);
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
  }

  .faq__pergunta::-webkit-details-marker {
    display: none;
  }

  .faq__pergunta::after {
    content: '';
    position: absolute;
    right: var(--esp-5);
    top: 50%;
    width: 0.6rem;
    height: 0.6rem;
    border-right: 2px solid var(--azul-ar);
    border-bottom: 2px solid var(--azul-ar);
    transform: translateY(-70%) rotate(45deg);
    transition: transform 0.15s;
  }

  .faq__item[open] .faq__pergunta::after {
    transform: translateY(-30%) rotate(-135deg);
  }

  .faq__resposta {
    margin: 0;
    padding: 0 var(--esp-5) var(--esp-5);
    color: var(--texto-suave);
  }
</style>
